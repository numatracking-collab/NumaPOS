{
  "appId": "com.numapos.dev",
  "productName": "NUMA POS DEV",
  "directories": {
    "output": "dist-electron-dev"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "assets/icon.png",
    "node_modules/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NUMA POS DEV"
  }
}