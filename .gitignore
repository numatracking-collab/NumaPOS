# ═══════════════════════════════════════════
# NUMA POS — .gitignore raíz
# ═══════════════════════════════════════════

# ── Variables de entorno (NUNCA al repo) ──
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# ── Dependencias ──
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Builds del frontend ──
frontend/dist/
frontend/dist-ssr/
frontend/dist-electron/

# ── Android (generado por Capacitor) ──
# La carpeta android/ en sí SÍ va al repo (tiene configuración manual),
# pero excluimos los builds compilados y archivos locales de Android Studio.
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/build/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/captures/
frontend/android/**/*.iml

# ── Keystore Android (CRÍTICO: nunca subir) ──
frontend/android/*.jks
frontend/android/keystore.properties

# ── Electron ──
frontend/electron/node_modules/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Sistema operativo ──
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Editores ──
.vscode/*
!.vscode/extensions.json
.idea/
*.local

# ── Archivos temporales de Capacitor ──
frontend/.capacitor/